{
  "name": "monitor-sefaz",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor de disponibilidade em tempo real dos webservices SEFAZ para documentos fiscais eletrônicos (NF-e, NFC-e, CT-e, MDF-e, DC-e, BP-e)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.24.0": ">=6.24.0",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0",
      "shell-quote@<1.11.0": ">=1.11.0",
      "sharp@<0.35.5": ">=0.35.5",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "ip-address@<10.7.1": ">=10.7.1"
    }
  }
}
