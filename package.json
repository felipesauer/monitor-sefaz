{
  "name": "monitor-sefaz",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor de disponibilidade em tempo real dos webservices SEFAZ para documentos fiscais eletrônicos (NF-e, NFC-e, CT-e, MDF-e, DC-e)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.24.0": ">=6.24.0",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0"
    }
  }
}
