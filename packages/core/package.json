{
  "name": "@monitor-sefaz/core",
  "version": "0.1.0",
  "description": "Motor de coleta de disponibilidade da SEFAZ: consenso multi-fonte com precedência oficial, parsers dos portais, envelopes SOAP e Notas Técnicas.",
  "keywords": [
    "sefaz",
    "nfe",
    "nfce",
    "cte",
    "mdfe",
    "dce",
    "nota-fiscal-eletronica",
    "brasil",
    "typescript",
    "disponibilidade",
    "status",
    "monitoring",
    "soap",
    "scraping"
  ],
  "license": "MIT",
  "author": "Felipe Sauer",
  "homepage": "https://github.com/felipesauer/monitor-sefaz/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipesauer/monitor-sefaz.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/felipesauer/monitor-sefaz/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@monitor-sefaz/catalog": "workspace:*",
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^5.0.5",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^4.5.7",
    "tough-cookie": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
}
